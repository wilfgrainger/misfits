{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "WebWorker"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["@cloudflare/workers-types", "node", "vitest/globals"]
  },
  "include": ["src/server", "src/shared", "tests/server", "tests/domain", "tests/helpers"]
}

{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "darts-501",
  "workers_dev": false,
  "main": "./src/server/index.ts",
  "compatibility_date": "2026-08-19",
  "vars": {
    "APP_ORIGIN": "https://darts.graingers.agency",
    "VITE_GOOGLE_CLIENT_ID": "283865619073-pbgbcaoamje9rutnq7sq59fd9lmqrme3.apps.googleusercontent.com"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/auth/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "misfits",
      "database_id": "9702b993-f0b7-479b-9679-7e32a1c35214",
      "migrations_dir": "./migrations"
    }
  ]
}
